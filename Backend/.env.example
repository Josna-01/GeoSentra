# ==============================================================
# GeoSentra Environment Variables (.env)
# Create a .env file in the Backend/ folder with these keys:
# ==============================================================

# 1. Google Gemini AI (Optional but Recommended for AI event extraction)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=apikeyenter

# 2. NewsAPI (Optional - pulls real-time geopolitical & supply chain news)
# Get a free developer key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# 3. Security (Pre-configured defaults are already provided in code)
JWT_SECRET=super-secure-jwt-secret-key
JWT_REFRESH_SECRET=super-secure-refresh-secret

# 4. Firebase Firestore (Optional - Defaults to local_db.json if omitted)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

